{
  "schemaVersion": 1,
  "policyVersion": "widget-v1",
  "repositories": [
    "owner/repo"
  ],
  "retryTestResults": {
    "aggregateJobSuffixes": [
      "Aggregate Results"
    ],
    "artifactNames": [
      "Combined-Results"
    ],
    "trxPathPattern": "^(?P<os>[^/]+)/testresults/(?P<lane>[^/]+?)(?=_net[^_]+_[^/]+\\.trx$|\\.trx$)(?:_net[^_]+_[^/]+)?\\.trx$",
    "jobNamePattern": "^(?:.* / )?(?P<lane>[^/]+) \\((?P<os>[^()]+)\\)$",
    "trustedEvents": [
      "push",
      "workflow_dispatch"
    ],
    "requireHeadRepositoryMatch": true
  },
  "quarantinePullRequest": {
    "baseRef": "trunk",
    "allowedHeadRepositories": [
      "owner/repo"
    ],
    "requiredApprovingReviews": 1
  }
}
