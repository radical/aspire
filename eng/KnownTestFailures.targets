<Project>
  <!-- Reflection xUnit reads this sidecar before deriving discovery UIDs. Keep checkout
       location and RID out of the identity; TFM remains part of the allowance boundary.
       https://github.com/xunit/xunit/blob/8bf043c053/src/xunit.v3.common/Utility/UniqueIDGenerator.cs -->
  <Target Name="KnownTestFailuresIdentity" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(IsTestProject)' == 'true' and '$(TargetFramework)' != ''">
    <PropertyGroup>
      <_KnownFailureIdentity>aspire-tests-v1:$([MSBuild]::MakeRelative('$(RepoRoot)', '$(MSBuildProjectFullPath)').Replace('\', '/')):$(TargetFramework)</_KnownFailureIdentity>
      <_KnownFailureSidecar>$(TargetDir)$(TargetName).uniqueid</_KnownFailureSidecar>
      <_KnownFailureOwner>$(TargetDir)$(TargetName).aspire-known-failure-identity</_KnownFailureOwner>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_KnownFailureSidecar)" Condition="Exists('$(_KnownFailureSidecar)')">
      <Output TaskParameter="Lines" ItemName="_KnownFailurePreviousIdentity" />
    </ReadLinesFromFile>
    <Error Condition="Exists('$(_KnownFailureSidecar)') and !Exists('$(_KnownFailureOwner)') and '$(KnownTestFailures)' == 'true'"
           Text="Known-test-failure identity conflicts with an authored sidecar." />
    <Error Condition="Exists('$(_KnownFailureOwner)') and '@(_KnownFailurePreviousIdentity)' != '$(_KnownFailureIdentity)'"
           Text="Generated known-test-failure identity was modified; refusing to replace or delete it." />
    <MakeDir Directories="$(TargetDir)" Condition="'$(KnownTestFailures)' == 'true'" />
    <WriteLinesToFile File="$(_KnownFailureSidecar)" Lines="$(_KnownFailureIdentity)" Overwrite="true"
                      Condition="'$(KnownTestFailures)' == 'true'" />
    <WriteLinesToFile File="$(_KnownFailureOwner)" Lines="$(_KnownFailureIdentity)" Overwrite="true"
                      Condition="'$(KnownTestFailures)' == 'true'" />
    <Delete Files="$(_KnownFailureSidecar);$(_KnownFailureOwner)"
            Condition="'$(KnownTestFailures)' != 'true' and Exists('$(_KnownFailureOwner)')" />
    <Delete Files="$(TargetDir)aspire-known-test-failures.xml"
            Condition="'$(KnownTestFailures)' != 'true'" />
  </Target>

  <!-- Author the receipt in the actual archive source before ZipDirectory. Consumers
       select exact inner-TFM archive outputs, not whichever DLLs happen to be present. -->
  <Target Name="KnownTestFailuresArchiveManifest" BeforeTargets="ZipTestArchive"
          DependsOnTargets="ComputeTestArchivePaths"
          Condition="'$(KnownTestFailures)' == 'true' and '$(_ShouldArchiveTests)' == 'true'">
    <ItemGroup>
      <_KnownFailureAdapter Include="@(PackageReference)" Condition="'%(Identity)' == 'xunit.v3.mtp-v2'" />
    </ItemGroup>
    <PropertyGroup>
      <_KnownFailureManifest>$(TestsArchiveSourceDir)/aspire-known-test-failures.xml</_KnownFailureManifest>
      <_KnownFailureAssembly>$([MSBuild]::MakeRelative('$(TestsArchiveSourceDir)', '$(TargetPath)').Replace('\', '/'))</_KnownFailureAssembly>
      <_KnownFailureProject>$([MSBuild]::MakeRelative('$(RepoRoot)', '$(MSBuildProjectFullPath)').Replace('\', '/'))</_KnownFailureProject>
      <_KnownFailureSupported>false</_KnownFailureSupported>
      <_KnownFailureSupported Condition="'@(_KnownFailureAdapter)' != '' and !$([System.String]::Copy('$(DefineConstants)').Contains('XUNIT_GENERATOR')) and '$(PublishAot)' != 'true'">true</_KnownFailureSupported>
    </PropertyGroup>
    <WriteLinesToFile File="$(_KnownFailureManifest)" Overwrite="true"
                      Lines="&lt;module schemaVersion=&quot;1&quot; project=&quot;&quot; framework=&quot;&quot; assembly=&quot;&quot; supportedAdapter=&quot;&quot; /&gt;" />
    <XmlPoke XmlInputPath="$(_KnownFailureManifest)" Query="/module/@project" Value="$(_KnownFailureProject)" />
    <XmlPoke XmlInputPath="$(_KnownFailureManifest)" Query="/module/@framework" Value="$(TargetFramework)" />
    <XmlPoke XmlInputPath="$(_KnownFailureManifest)" Query="/module/@assembly" Value="$(_KnownFailureAssembly)" />
    <XmlPoke XmlInputPath="$(_KnownFailureManifest)" Query="/module/@supportedAdapter" Value="$(_KnownFailureSupported)" />
  </Target>

  <!-- Evaluated by the same inner build used for testing, never by scanning bin/.
       RunArguments contains the normal MTP arguments after ComputeRunArguments.
       TestRunnerAdditionalArguments belongs to Arcade/Helix and is NOT composed here. -->
  <Target Name="KnownTestFailuresModule" DependsOnTargets="GetTargetPath;ComputeRunArguments;ComputeTestArchivePaths">
    <Error Condition="'$(IsTestProject)' != 'true' or '$(IsTestingPlatformApplication)' != 'true' or '$(TargetFramework)' == ''"
           Text="Known-test-failure execution requires an inner MTP test project." />
  </Target>
</Project>
