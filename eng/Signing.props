<?xml version="1.0" encoding="utf-8"?>
<Project>
  <ItemGroup>
    <FileExtensionSignInfo Update=".nupkg" CertificateName="NuGet" />
    <FileExtensionSignInfo Update=".zip" CertificateName="None" />
    <!--
      VS Code extension: Don't Authenticode sign the .vsix file itself.
      The manifest is generated from the VSIX before signing, so signing the VSIX would
      change its size/hash and cause PackageIntegrityCheckFailed during verification.
      Only the .signature.p7s file needs to be signed (handled by extension/signing/signVsix.proj).
    -->
    <FileExtensionSignInfo Update=".vsix" CertificateName="None" />

    <!-- add missing entry for .msi, this can be removed once aspire uses arcade 10.0 -->
    <FileExtensionSignInfo Include=".msi" CertificateName="Microsoft400" Condition="!@(FileExtensionSignInfo->AnyHaveMetadataValue('Identity', '.msi'))" />

    <!--
      JS files in project templates are customer-modifiable: users edit them after project
      creation. Authenticode signing would append a // SIG // block that is visible to users
      and breaks on any edit. Instead, we catalog-sign: a .cat file hashes the JS files and
      carries the signature, leaving the JS content untouched.
      See GenerateCatalogFiles target in Aspire.ProjectTemplates.csproj.
    -->
    <FileExtensionSignInfo Update=".js" CertificateName="None" />
    <!-- Sign the catalog file that covers the template JS files -->
    <FileExtensionSignInfo Include=".cat" CertificateName="Microsoft400" />
    <!-- Remove .py files from being signed. See https://github.com/microsoft/aspire/issues/13004 -->
    <FileExtensionSignInfo Update=".py" CertificateName="None" />
  </ItemGroup>

  <ItemGroup>
    <FileSignInfo Include="Dapper.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Fractions.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Hex1b.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="hex1bpty.exe" CertificateName="3PartySHA2" />
    <FileSignInfo Include="IdentityModel.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="IdentityModel.OidcClient.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="KubernetesClient.Basic.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="KubernetesClient.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="KubernetesClient.Models.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Prometheus.NetStandard.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="QRCoder.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="YamlDotNet.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Grpc.AspNetCore.Server.ClientFactory.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Grpc.AspNetCore.Server.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Grpc.Core.Api.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Grpc.Net.Client.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Grpc.Net.ClientFactory.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Grpc.Net.Common.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Markdig.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="MessagePack.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="MessagePack.Annotations.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="ModelContextProtocol.Core.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="ModelContextProtocol.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenAI.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Spectre.Console.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Spectre.Console.Ansi.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenTelemetry.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenTelemetry.Api.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenTelemetry.Api.ProviderBuilderExtensions.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenTelemetry.Exporter.Console.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenTelemetry.Exporter.OpenTelemetryProtocol.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenTelemetry.Extensions.Hosting.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenTelemetry.Instrumentation.AspNetCore.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenTelemetry.PersistentStorage.Abstractions.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="OpenTelemetry.PersistentStorage.FileSystem.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="SQLitePCLRaw.batteries_v2.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="SQLitePCLRaw.core.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="SQLitePCLRaw.provider.e_sqlite3.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="BouncyCastle.Cryptography.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="e_sqlite3.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Semver.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Sigstore.dll" CertificateName="3PartySHA2" />
    <FileSignInfo Include="Tuf.dll" CertificateName="3PartySHA2" />

    <!-- Aspire is a Microsoft product rather than a .NET runtime binary, so use Arcade's general Microsoft certificate. -->
    <FileSignInfo Condition="$([System.OperatingSystem]::IsWindows())" Include="aspire.exe" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsWindows())" Include="aspire-managed.exe" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsWindows())" Include="aspire-tray.exe" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsWindows())" Include="Aspire.Dashboard.exe" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsWindows())" Include="Aspire.Hosting.Native.Server.exe" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsLinux())" Include="Aspire.Hosting.Native.Server" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsMacOS())" Include="Aspire.Hosting.Native.Server" CertificateName="MacDeveloperHardenWithNotarization" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsWindows())" Include="Aspire.TerminalHost.exe" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsLinux())" Include="aspire" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsLinux())" Include="aspire-managed" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsLinux())" Include="Aspire.Dashboard" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsLinux())" Include="Aspire.TerminalHost" CertificateName="Microsoft400" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsMacOS())" Include="aspire" CertificateName="MacDeveloperHardenWithNotarization" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsMacOS())" Include="aspire-managed" CertificateName="MacDeveloperHardenWithNotarization" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsMacOS())" Include="Aspire.Dashboard" CertificateName="MacDeveloperHardenWithNotarization" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsMacOS())" Include="Aspire.TerminalHost" CertificateName="MacDeveloperHardenWithNotarization" />
    <FileSignInfo Condition="$([System.OperatingSystem]::IsWindows())" Include="get-aspire-cli.ps1" CertificateName="Microsoft400" />

    <!-- Sign the manifest catalog on Windows -->
    <FileSignInfo Condition="$([System.OperatingSystem]::IsWindows())" Include="manifest.cat" CertificateName="Microsoft400" />

    <!--
      npm packages are tarballs, but only the Aspire CLI npm tarballs should get
      detached signatures. Scope these rules to the npm package ItemsToSign
      collision id so the global .tgz/.js/native-executable defaults remain
      unchanged for unrelated artifacts.
    -->
    <FileExtensionSignInfo Include=".tgz" CertificateName="LinuxSign500180PGP" CollisionPriorityId="AspireCliNpmPackage" />
    <FileSignInfo Include="aspire.js" CertificateName="Microsoft400" CollisionPriorityId="AspireCliNpmPackage" />
    <FileSignInfo Include="aspire.exe" CertificateName="None" CollisionPriorityId="AspireCliNpmPackage" />
    <FileSignInfo Include="aspire" CertificateName="None" CollisionPriorityId="AspireCliNpmPackage" />
  </ItemGroup>

  <ItemGroup>
    <ItemsToSign Include="$(VisualStudioSetupInsertionPath)\**\*.msi" Condition="'$(PostBuildSign)' != 'true'" />
    <ItemsToSign Include="$(ArtifactsPackagesDir)**\*.wixpack.zip" Condition="'$(PostBuildSign)' != 'true'" />
    <ItemsToSignPostBuild Include="$(VisualStudioSetupInsertionPath)\**\*.msi" Condition="'$(PostBuildSign)' == 'true'" />
    <ItemsToSign Include="$(VisualStudioSetupInsertionPath)\**\*.zip" Condition="'$(PostBuildSign)' != 'true'" />
    <ItemsToSign Include="$(ArtifactsPackagesDir)**\aspire-cli-*.zip" />
    <ItemsToSign Include="$(ArtifactsPackagesDir)**\aspire-cli-*.tar.gz" />
    <ItemsToSign Include="$(ArtifactsShippingPackagesDir)**\microsoft-aspire-cli*.tgz" CollisionPriorityId="AspireCliNpmPackage" />
    <ItemsToSign Include="$(RepoRoot)eng\scripts\get-aspire-cli.ps1" Condition="$([System.OperatingSystem]::IsWindows())" />

    <!-- Sign only the final NativeAOT CLI publish output; CLI archives are signed separately. -->
    <ItemsToSign Condition="$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.Cli.*\**\publish\aspire.exe" />
    <ItemsToSign Condition="!$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.Cli.*/**/publish/aspire" />
  </ItemGroup>

  <!-- The final macOS bundle pass consumes components already signed before layout
       creation. Signing their publish copies again cannot update the embedded payload.
       Keep container discovery and certificates unchanged: new NuGet packages still
       require recursive signing and their outer NuGet signature. -->
  <ItemGroup Condition="'$(SkipBundleComponentSigning)' != 'true' or !$([System.OperatingSystem]::IsMacOS())">
    <!-- Sign the aspire-managed binary at its publish output path (before it gets packed into the bundle archive) -->
    <ItemsToSign Condition="$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.Managed\**\publish\aspire-managed.exe" />
    <ItemsToSign Condition="$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.Tray.Windows\**\publish\aspire-tray.exe" />
    <!-- Bundle builds can reuse a tray published outside the standard artifacts tree. -->
    <ItemsToSign Condition="'$(WindowsTrayPath)' != '' and $(TargetRid.StartsWith('win-'))"
                 Include="$([MSBuild]::NormalizePath('$(WindowsTrayPath)', 'aspire-tray.exe'))"
                 Exclude="@(ItemsToSign)" />
    <ItemsToSign Condition="$([System.OperatingSystem]::IsLinux())" Include="$(ArtifactsBinDir)Aspire.Managed/**/publish/aspire-managed" />
    <ItemsToSign Condition="$([System.OperatingSystem]::IsMacOS())" Include="$(ArtifactsBinDir)Aspire.Managed/**/publish/aspire-managed" />
    <!-- The whole macOS tray app is signed/notarized separately by
         eng/pipelines/SignTray.proj, without Arcade's extra ZIP wrapping. -->
    <!-- Select only Hex1b's unsigned helper, preserving the upstream signatures on ConPTY and OpenConsole. -->
    <ItemsToSign Condition="$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.TerminalHost\**\publish\hex1bpty.exe" />
    <ItemsToSign Condition="$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.TerminalHost\**\publish\Aspire.TerminalHost.exe" />
    <ItemsToSign Condition="!$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.TerminalHost/**/publish/Aspire.TerminalHost" />
    <ItemsToSign Condition="$([System.OperatingSystem]::IsMacOS())" Include="$(ArtifactsBinDir)Aspire.TerminalHost/**/publish/*.dylib" />
    <ItemsToSign Condition="$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.Dashboard\**\publish\Aspire.Dashboard.exe" />
    <ItemsToSign Condition="!$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.Dashboard/**/publish/Aspire.Dashboard" />
    <ItemsToSign Condition="$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.Hosting.Native.Server\**\publish\Aspire.Hosting.Native.Server.exe" />
    <ItemsToSign Condition="!$([System.OperatingSystem]::IsWindows())" Include="$(ArtifactsBinDir)Aspire.Hosting.Native.Server/**/publish/Aspire.Hosting.Native.Server" Exclude="$(ArtifactsBinDir)**/*.dSYM/**" />
    <!-- Hardened runtime library validation requires bundled dylibs to use the Dashboard's Team ID.
         Arcade's default .dylib rule signs these with MacDeveloperHarden. -->
    <ItemsToSign Condition="$([System.OperatingSystem]::IsMacOS())" Include="$(ArtifactsBinDir)Aspire.Dashboard/**/publish/*.dylib" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Note: VS Code extension (.vsix) is NOT included here.
      Signing the VSIX changes its hash, breaking manifest integrity verification.
      Only the .signature.p7s is signed via extension/signing/signVsix.proj.
    -->
    <ItemsToSignPostBuild Include="$(VisualStudioSetupInsertionPath)\**\*.zip" Condition="'$(PostBuildSign)' == 'true'" />
  </ItemGroup>

  <Target Name="_ValidateBundleFinalSigningInputs"
          BeforeTargets="Sign"
          Condition="'$(SkipBundleComponentSigning)' == 'true' and $([System.OperatingSystem]::IsMacOS())">
    <PropertyGroup>
      <_BundleSigningBinPathPattern>$([System.Text.RegularExpressions.Regex]::Escape('$([MSBuild]::NormalizeDirectory('$(ArtifactsBinDir)'))'))</_BundleSigningBinPathPattern>
    </PropertyGroup>
    <ItemGroup>
      <!-- Match prepared paths such as Aspire.Dashboard/osx-arm64/Release/net11.0/osx-arm64/publish/Aspire.Dashboard,
           not similarly named files discovered recursively inside distribution containers. -->
      <_UnexpectedBundleComponentToSign Include="@(ItemsToSign)"
                                        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ItemsToSign.FullPath)', '^$(_BundleSigningBinPathPattern)Aspire\.(Managed|TerminalHost|Dashboard|Hosting\.Native\.Server)/.*/publish/'))" />
      <_BundleCliArchiveToSign Include="@(ItemsToSign)"
                               Condition="Exists('%(ItemsToSign.Identity)') and $([System.Text.RegularExpressions.Regex]::IsMatch('%(ItemsToSign.Filename)%(ItemsToSign.Extension)', '^aspire-cli-$(TargetRid)-.+\.tar\.gz$'))" />
      <_BundleDashboardPackageToSign Include="@(ItemsToSign)"
                                     Condition="Exists('%(ItemsToSign.Identity)') and $([System.Text.RegularExpressions.Regex]::IsMatch('%(ItemsToSign.Filename)%(ItemsToSign.Extension)', '^Aspire\.Dashboard\.Sdk\.$(TargetRid)\..+\.nupkg$'))" />
    </ItemGroup>
    <Error Condition="'@(_UnexpectedBundleComponentToSign)' != ''"
           Text="Final macOS bundle signing must exclude prepared component publish files: @(_UnexpectedBundleComponentToSign, ', '). Keep SkipBundleComponentSigning scoped to the final pass and exclude these inputs from ItemsToSign." />
    <Error Condition="'$(BundlePayloadPath)' != '' and '@(_BundleCliArchiveToSign)' == ''"
           Text="Final macOS bundle signing must include the produced aspire-cli-$(TargetRid)-*.tar.gz archive. Ensure CLI packaging completes before signing and the archive remains in ItemsToSign." />
    <Error Condition="'$(PostBuildSign)' != 'true' and '@(_BundleDashboardPackageToSign)' == ''"
           Text="Final macOS bundle signing must include the produced Aspire.Dashboard.Sdk.$(TargetRid).*.nupkg package. Ensure Dashboard packing completes before signing and default NuGet discovery remains enabled." />
  </Target>
</Project>
