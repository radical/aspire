{
  "automation": "c5a59a67-c2b8-4bda-81a0-a3f13e59d371",
  "maxConcurrentRuns": 5,
  "triggers": [
    { "event": "issues.labeled", "labels": ["cif:ready"], "itemLabels": [["cif", "cif:p0", "cif:ready"]] },
    { "event": "issues.labeled", "labels": ["cif:p0"], "itemLabels": [["cif", "cif:p0", "cif:ready"]] },
    { "event": "pull_request_review.submitted", "itemLabels": [["cif-pr", "cif:p0"]] },
    { "event": "issue_comment.created", "itemLabels": [["cif-pr", "cif:p0"]] },
    { "event": "pull_request.required_checks_completed", "itemLabels": [["cif-pr", "cif:p0"]], "conclusions": ["failure", "success"] },
    { "event": "pull_request.closed", "itemLabels": [["cif-pr", "cif:p0"]], "merged": true },
    { "event": "pull_request.closed", "itemLabels": [["cif-pr", "cif:p0"]], "merged": false },
    { "event": "cron", "cron": "*/15 * * * *" }
  ]
}
